{
  "name": "@ptl/test-utils",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shared testing utilities for PTL packages",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./fixtures": {
      "types": "./dist/fixtures/index.d.ts",
      "import": "./dist/fixtures/index.js"
    },
    "./mocks": {
      "types": "./dist/mocks/index.d.ts",
      "import": "./dist/mocks/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/fixtures/index.ts src/mocks/index.ts --format esm --dts",
    "dev": "tsup src/index.ts src/fixtures/index.ts src/mocks/index.ts --format esm --dts --watch",
    "clean": "rimraf dist",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ptl/core": "workspace:*",
    "@ptl/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "rimraf": "^5.0.5",
    "tsup": "^8.0.1",
    "typescript": "~5.3.3",
    "vitest": "^4.0.18"
  },
  "peerDependencies": {
    "vitest": "^1.0.0"
  }
}
