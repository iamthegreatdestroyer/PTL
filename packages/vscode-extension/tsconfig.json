{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "lib": ["ES2022"],
    "module": "CommonJS",
    "moduleResolution": "Node",
    "composite": true,
    "tsBuildInfoFile": "./dist/.tsbuildinfo"
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "out", "**/*.test.ts"],
  "references": [{ "path": "../shared" }, { "path": "../config" }, { "path": "../core" }]
}
