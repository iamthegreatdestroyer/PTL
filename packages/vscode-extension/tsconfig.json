{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "lib": ["ES2022"],
    "module": "CommonJS",
    "moduleResolution": "Node",
    "composite": false,
    "verbatimModuleSyntax": false,
    "importHelpers": false
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "out", "**/*.test.ts"]
}
