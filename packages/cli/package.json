{
  "name": "@ptl/cli",
  "version": "0.0.1",
  "description": "Command-line interface for PTL - Probabilistic Type Lattice analyzer",
  "type": "module",
  "bin": {
    "ptl": "./dist/bin.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "node dist/bin.js"
  },
  "dependencies": {
    "@ptl/core": "workspace:*",
    "@ptl/config": "workspace:*",
    "@ptl/shared": "workspace:*",
    "@ptl/type-priors": "workspace:*",
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "ora": "^8.0.1",
    "figures": "^6.0.1",
    "picocolors": "^1.0.0",
    "typescript": "^5.3.3"
  },
  "devDependencies": {
    "tsup": "^8.0.1",
    "vitest": "^4.0.18",
    "@types/node": "^20.11.5"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/iamthegreatdestroyer/PTL.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/iamthegreatdestroyer/PTL#readme",
  "bugs": {
    "url": "https://github.com/iamthegreatdestroyer/PTL/issues"
  },
  "license": "MIT",
  "keywords": [
    "ptl",
    "cli",
    "typescript",
    "type-inference",
    "bayesian"
  ]
}
